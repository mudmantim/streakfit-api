{"id": "SF-RID-000001", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I have a spine but no bones, ribs but no chest. What am I?\n\nA book."}
{"id": "SF-RID-000002", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "The more of me you take, the more you leave behind. What am I?\n\nFootsteps."}
{"id": "SF-RID-000003", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I go up when the rain comes down. What am I?\n\nAn umbrella."}
{"id": "SF-RID-000004", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I'm full of holes but I still hold water. What am I?\n\nA sponge."}
{"id": "SF-RID-000005", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I have hands but cannot clap. What am I?\n\nA clock."}
{"id": "SF-RID-000006", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I run all day and never get tired, and I have a mouth but never eat.\n\nA river."}
{"id": "SF-RID-000007", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What gets wetter the more it dries?\n\nA towel."}
{"id": "SF-RID-000008", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I'm tall when I'm young and short when I'm old. What am I?\n\nA candle."}
{"id": "SF-RID-000009", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has one eye but cannot see?\n\nA needle."}
{"id": "SF-RID-000010", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What can travel around the world while staying in one corner?\n\nA stamp."}
{"id": "SF-RID-000011", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I'm light as a feather, but the strongest person can't hold me for long.\n\nYour breath."}
{"id": "SF-RID-000012", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has legs but doesn't walk?\n\nA table."}
{"id": "SF-RID-000013", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I have a neck but no head, and I wear a cap. What am I?\n\nA bottle."}
{"id": "SF-RID-000014", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "The person who makes me doesn't want me. The person who buys me doesn't use me. The person who uses me never knows.\n\nA coffin."}
{"id": "SF-RID-000015", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has keys but opens no locks?\n\nA piano."}
{"id": "SF-RID-000016", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has a bed but never sleeps?\n\nA river."}
{"id": "SF-RID-000017", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What can you catch but never throw?\n\nA cold."}
{"id": "SF-RID-000018", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "I'm always in front of you but you can never see me. What am I?\n\nThe future."}
{"id": "SF-RID-000019", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has a thumb and four fingers but isn't alive?\n\nA glove."}
{"id": "SF-RID-000020", "category": "Riddles", "min_age": 9, "confidence": "editorial", "sources": [], "status": "accepted", "added": "2026-09-19", "batch": "0002-discovery", "type": "riddle", "text": "What has words but never speaks?\n\nA book."}
