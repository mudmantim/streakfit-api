# StreakFit — environment template.
# Copy to `.env` (git-ignored) for local dev, or set these in the Render dashboard for prod.
#   cp .env.example .env   &&   edit the values
# `make setup` will create .env from this file with generated dev secrets if it's missing.
# Full reference (required-vs-optional, defaults, effects): docs/operations/environment.md
# NEVER commit real secret values. .env and .env.* are git-ignored (this template is the exception).

# ─── REQUIRED (the app raises RuntimeError at import if these are missing) ───────

# Flask session/signing secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT signing key (HS256). Generate the same way; use a DIFFERENT value from SECRET_KEY.
JWT_SECRET_KEY=

# ─── DATABASE ───────────────────────────────────────────────────────────────────

# SQLAlchemy connection string.
#   • Local dev: leave UNSET to fall back to a local SQLite file (sqlite:///streakfit.db).
#   • Production: a PostgreSQL URL. A `postgres://` prefix is auto-rewritten to `postgresql://`.
# DATABASE_URL=postgresql://user:pass@host:5432/streakfit

# ─── COACH (Rickie) — OPTIONAL ──────────────────────────────────────────────────

# Anthropic API key. WITHOUT it, /api/coach returns 503 and the rest of the app is unaffected
# (fail-closed by design). Leave blank locally unless you're working on Rickie.
ANTHROPIC_API_KEY=

# ─── ADMIN SURFACE — OPTIONAL (recommended in prod) ─────────────────────────────

# Shared secret for /api/admin/* (sent as the X-Admin-Secret header). If UNSET/empty,
# every admin route fails closed with 403. Generate like the secrets above.
ADMIN_SECRET=

# ─── OPERATIONAL TOGGLES — OPTIONAL ─────────────────────────────────────────────

# Boot guard. Set to exactly "1" in PRODUCTION so the process refuses to start
# (SystemExit 1) unless the DB is stamped at the Alembic head. Leave UNSET locally
# and during `flask db upgrade` (it must not fire mid-migration).
# STREAKFIT_ENFORCE_DB_HEAD=1

# Flask-Limiter storage backend. Default "memory://" (per-worker, resets each deploy).
# For real shared limits across workers/instances, point at Redis: redis://host:6379
# RATELIMIT_STORAGE_URI=memory://

# Commit SHA shown in the admin dashboard. Render sets this automatically in prod;
# locally the app falls back to `git rev-parse HEAD`.
# RENDER_GIT_COMMIT=

# Dev server port (used only by `python app.py`; gunicorn is used in prod).
# PORT=5000
